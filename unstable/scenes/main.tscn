[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/facility/flooded_reactor.tscn" id="2_level"]
[ext_resource type="PackedScene" path="res://scenes/ui/main_menu.tscn" id="3_menu"]
[ext_resource type="PackedScene" path="res://scenes/ui/results_screen.tscn" id="4_results"]
[ext_resource type="PackedScene" path="res://scenes/ui/pause_menu.tscn" id="5_pause"]

[node name="Main" type="Node"]
script = ExtResource("1_main")
mission_scene = ExtResource("2_level")

[node name="World" type="Node3D" parent="."]

[node name="MissionSpawner" type="MultiplayerSpawner" parent="."]
_spawnable_scenes = PackedStringArray("res://scenes/facility/flooded_reactor.tscn")
spawn_path = NodePath("../World")

[node name="UI" type="CanvasLayer" parent="."]
layer = 10

[node name="MainMenu" parent="UI" instance=ExtResource("3_menu")]
unique_name_in_owner = true

[node name="ResultsScreen" parent="UI" instance=ExtResource("4_results")]
unique_name_in_owner = true

[node name="PauseMenu" parent="UI" instance=ExtResource("5_pause")]
unique_name_in_owner = true

[connection signal="spawned" from="MissionSpawner" to="." method="_on_mission_started"]
[connection signal="solo_requested" from="UI/MainMenu" to="." method="start_solo"]
[connection signal="host_requested" from="UI/MainMenu" to="." method="start_host"]
[connection signal="join_requested" from="UI/MainMenu" to="." method="start_join"]
[connection signal="quit_requested" from="UI/MainMenu" to="." method="quit"]
[connection signal="restart_requested" from="UI/ResultsScreen" to="." method="start_mission"]
[connection signal="leave_requested" from="UI/ResultsScreen" to="." method="leave"]
[connection signal="resume_requested" from="UI/PauseMenu" to="." method="resume"]
[connection signal="restart_requested" from="UI/PauseMenu" to="." method="start_mission"]
[connection signal="leave_requested" from="UI/PauseMenu" to="." method="leave"]
