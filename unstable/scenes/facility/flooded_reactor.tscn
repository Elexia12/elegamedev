[node name="FloodedReactor" type="Node3D"]
editor_description = "LEVEL ROOT (Mission).
Only 3 jobs: receive player actions (request), decide the outcome when the lift leaves or the facility collapses, and pack all 'net' nodes into one snapshot for clients.
Every system below is its own child node."
script = ExtResource("1_mi")

[node name="MissionClock" type="Node" parent="."]
editor_description = "Mission timer. Instability rises 0 -> 1 over collapse_time; every hazard scales with it.
Signals: phase_changed -> Mission (phase banner), collapsed -> Mission (run fails)."
unique_name_in_owner = true
script = ExtResource("16_clk")

[node name="PressureNetwork" type="Node" parent="." node_paths=PackedStringArray("burst_zone", "burst_vent")]
editor_description = "Coolant pressure 0-100%. Rises on its own. Gate jack and DrainPump spend it.
Held at 100% -> line bursts -> floods burst_zone (LowerFlood) and fires BurstVent steam."
unique_name_in_owner = true
script = ExtResource("17_pn")
burst_zone = NodePath("../Water/LowerFlood")
burst_vent = NodePath("../Piping/BurstVent")

[node name="DrainPump" type="Node" parent="." node_paths=PackedStringArray("valve", "network", "source", "target")]
editor_description = "Valve-controlled pump: moves water from source (storage) to target (lower facility) and spends pressure.
The trade-off: protect the bonus cargo, flood the main hall."
script = ExtResource("18_dp")
valve = NodePath("../Manifold/DrainValve")
network = NodePath("../PressureNetwork")
source = NodePath("../Water/BonusFlood")
target = NodePath("../Water/LowerFlood")

[node name="IncidentLog" type="Node" parent="."]
editor_description = "Messages to players and the incident list for the results screen.
Signals: message / client_event -> HUD."
unique_name_in_owner = true
script = ExtResource("19_il")

[node name="Toolkit" type="Node3D" parent="."]
editor_description = "Team equipment shared by all players: the Cable children (add more to give the team more cables) and team_braces."
unique_name_in_owner = true
