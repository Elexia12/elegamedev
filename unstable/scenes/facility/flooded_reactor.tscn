[node name="FloodedReactor" type="Node3D"]
editor_description = "LEVEL ROOT (Mission).
Only 3 jobs: receive player actions (request), run the ending (lift departs or the facility physically collapses), and pack all 'net' nodes into one snapshot for clients.
Every system below is its own child node."
script = ExtResource("1_mi")

[node name="Contract" type="Node" parent="." node_paths=PackedStringArray("lower_flood", "storage_flood")]
unique_name_in_owner = true
editor_description = "THE RULES OF THIS LEVEL (ReactorContract): get the reactor core (primary) and bonus container (optional) onto the lift and ride it out. Builds the HUD text and the results screen."
script = ExtResource("28_rc")
lower_flood = NodePath("../Water/LowerFlood")
storage_flood = NodePath("../Water/BonusFlood")

[node name="MissionClock" type="Node" parent="."]
unique_name_in_owner = true
editor_description = "Mission timer. Instability rises 0 -> 1 over collapse_time; every hazard scales with it.
Signals: phase_changed -> Mission (big tremor), collapsed -> Mission (final collapse sequence)."
script = ExtResource("16_clk")

[node name="Tremors" type="Node3D" parent="." node_paths=PackedStringArray("sun")]
unique_name_in_owner = true
editor_description = "How the collapse reaches you: periodic tremors (more frequent as instability rises) shake cameras, shove loose props, damage supports and shake Rubble loose. Dust children pour while shaking; lights in group facility_lights flicker."
script = ExtResource("23_tr")
sun = NodePath("../Environment/Sun")

