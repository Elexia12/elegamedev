[node name="PressureNetwork" type="Node" parent="." node_paths=PackedStringArray("burst_zone", "burst_vent", "rattle")]
unique_name_in_owner = true
editor_description = "Coolant pressure 0-100%. Rises on its own. Gate jack and DrainPump spend it.
Above warning_level the JackLine pipe rattles and the vent spits steam. Held at 100% the line bursts: a water jet from BurstVent knocks crew and cargo away and LowerFlood rises."
script = ExtResource("17_pn")
burst_zone = NodePath("../Water/LowerFlood")
burst_vent = NodePath("../Piping/BurstVent")
rattle = NodePath("../Piping/JackLine")

[node name="DrainPump" type="Node" parent="." node_paths=PackedStringArray("valve", "network", "source", "target")]
editor_description = "Valve-controlled pump: moves water from source (storage) to target (lower facility) and spends pressure.
The trade-off: protect the bonus cargo, flood the main hall."
script = ExtResource("18_dp")
valve = NodePath("../Manifold/DrainValve")
network = NodePath("../PressureNetwork")
source = NodePath("../Water/BonusFlood")
target = NodePath("../Water/LowerFlood")

