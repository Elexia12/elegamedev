pressure_network = NodePath("../PressureNetwork")

[node name="Supports" type="Node3D" parent="."]
editor_description = "Structural supports: STABLE -> STRAINED -> CRITICAL -> FAILED over time and under cable load on their anchors.
See each support's 'failed' signal in Node > Signals for what breaks next."

[node name="SupportGateFrame" parent="Supports" instance=ExtResource("3_sup")]
