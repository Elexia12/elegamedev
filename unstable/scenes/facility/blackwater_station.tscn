[node name="BlackwaterStation" type="Node3D"]
editor_description = "LEVEL ROOT (Mission): BLACKWATER PUMPING STATION, prototype 01.
Layout follows the spec blockout: A extraction bay (north), B control room + C pump hall, D damaged corridor (under B), E maintenance pit (south).
The Contract node holds the rules; every system below is its own child node."
script = ExtResource("1_missio")

[node name="Contract" type="Node" parent="." node_paths=PackedStringArray("deposit", "departure", "corridor", "flood_zone")]
editor_description = "THE RULES OF THIS LEVEL (SalvageContract).
CONTRACT: VFD power module · JACKPOT: pump motor · BONUS: pressure transmitters.
Salvage counts once secured at the DepositZone. The run ends when the Truck leaves (or the station fails).
briefing_text shows on screen until you first walk into the station."
unique_name_in_owner = true
script = ExtResource("2_salvag")
deposit = NodePath("../Bay/DepositZone")
departure = NodePath("../Bay/Truck")
corridor = NodePath("../DamagedCorridor")
flood_zone = NodePath("../Water/StationFlood")
briefing_text = "THE JOB
VFD module · control room
Pump motor · pump hall (hoist it onto the trolley)
Sensors · maintenance pit
Bring salvage to the green zone.
Start the truck to leave.
Wrench [1]: hold LMB on bolts"

[node name="MissionClock" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("3_missio")
editor_description = "15 min to station failure. Instability 0 -> 1 raises seepage and tremors.
Signals: phase_changed -> Mission (tremor), collapsed -> Mission."
collapse_time = 900

