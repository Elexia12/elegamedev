[node name="BlackwaterStation" type="Node3D"]
editor_description = "LEVEL ROOT (Mission): BLACKWATER PUMPING STATION, prototype 01.
An insurance salvage job in a flooding pumping station. The Contract node holds the rules; every system below is its own child node.
Mission only receives player actions, runs the ending and replicates every node in group \"net\"."
script = ExtResource("1_missio")

[node name="Contract" type="Node" parent="." node_paths=PackedStringArray("deposit", "departure", "corridor", "flood_zone")]
editor_description = "THE RULES OF THIS LEVEL (SalvageContract).
CONTRACT: VFD power module · JACKPOT: pump motor · BONUS: pressure transmitters.
Salvage counts once secured at the DepositZone (value = base × condition then). The run ends when the Truck leaves (or the station fails); anyone left inside costs rescue_fee."
unique_name_in_owner = true
script = ExtResource("2_salvag")
deposit = NodePath("../Extraction/DepositZone")
departure = NodePath("../Extraction/Truck")
corridor = NodePath("../DamagedCorridor")
flood_zone = NodePath("../Water/StationFlood")

[node name="MissionClock" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("3_missio")
editor_description = "Mission timer: instability 0 -> 1 over collapse_time (15 min), raising seepage and tremors. At the end the station fails (Contract.on_collapse: corridor drops, a flood surge).
Signals: phase_changed -> Mission (tremor), collapsed -> Mission."
collapse_time = 900

[node name="Tremors" type="Node3D" parent="." node_paths=PackedStringArray("sun")]
unique_name_in_owner = true
script = ExtResource("4_tremor")
editor_description = "Periodic tremors (more often as instability rises): camera shake, shoves loose props, knocks wrenches off bolts, shakes Rubble loose."
sun = NodePath("../Environment/Sun")
calm_interval = 55
unstable_interval = 14
rubble_chance = 0.25
support_damage = 0

