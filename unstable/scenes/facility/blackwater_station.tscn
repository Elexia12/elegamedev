editor_description = "THE SECOND CHANCE (OverheadHoist). A maintenance hoist on a rail under the corridor ceiling, from over the corridor's middle (x = -7 local) out into the pump hall (x = +7). If the corridor collapses with the motor, it is still down in the void: hook it there, lift it out into the hall, lower it onto the trolley, and take the service tunnel.
The rail stops short of the corridor's solid west end, so it can't carry the motor across the weak deck."
display_name = "Corridor hoist"
rail_length = 14.0
max_length = 5.5
hook_reach = 2.0
start_x = 5
start_length = 0.8

