[gd_resource type="Theme" load_steps=3 format=3]

[sub_resource type="StyleBoxFlat" id="Style_panel"]
content_margin_left = 10.0
content_margin_top = 10.0
content_margin_right = 10.0
content_margin_bottom = 10.0
bg_color = Color(0.05, 0.07, 0.09, 0.7)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="Style_card"]
content_margin_left = 24.0
content_margin_top = 24.0
content_margin_right = 24.0
content_margin_bottom = 24.0
bg_color = Color(0.09, 0.11, 0.13, 0.95)
border_width_top = 4
border_color = Color(0.95, 0.75, 0.1, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[resource]
Button/constants/h_separation = 8
Card/base_type = &"PanelContainer"
Card/styles/panel = SubResource("Style_card")
Label/colors/font_shadow_color = Color(0, 0, 0, 0.8)
Label/constants/shadow_offset_x = 1
Label/constants/shadow_offset_y = 1
PanelContainer/styles/panel = SubResource("Style_panel")
