[node name="Trolley" type="RigidBody3D"]
editor_description = "PLATFORM TROLLEY (Trolley), handles like a shopping cart. [E] takes the handle (two crew can push), [E] again lets go. While held it stays rigidly in front of you: walk to push, turn to steer. Fixed wheels at the handle end (FixedAxle), swivel casters at the far end.
Cargo on the deck is held by deck_friction only (no straps): brake, ram or turn too hard and the motor slides off.
Tuning: push_force / push_torque (what your hands can do), hold_stiffness / turn_stiffness (how rigid the grip is), axle_grip / skid_friction (cornering), rolling_resistance / drag (how far it coasts)."
collision_layer = 4
collision_mask = 23
mass = 70
physics_material_override = SubResource("Phys_trolley")
angular_damp = 1.5
script = ExtResource("1_trolle")
display_name = "Trolley"
role = "equipment"
buoyancy = 0.5
height = 0.9
hit_speed = 3

