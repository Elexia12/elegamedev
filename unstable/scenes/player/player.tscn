[gd_scene load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/player/crew_member.gd" id="1_cm"]
[ext_resource type="Script" path="res://scripts/player/winch_tool.gd" id="2_wt"]
[ext_resource type="Script" path="res://scripts/player/brace_tool.gd" id="3_bt"]
[ext_resource type="Script" path="res://scripts/player/pressure_tool.gd" id="4_pt"]
[ext_resource type="Script" path="res://scripts/player/hands.gd" id="5_ha"]
[ext_resource type="Script" path="res://scripts/player/vitals.gd" id="6_vi"]

[sub_resource type="CapsuleShape3D" id="Shape_body"]
radius = 0.35
height = 1.8

[sub_resource type="CapsuleMesh" id="Mesh_body"]
radius = 0.35
height = 1.8

[sub_resource type="StandardMaterial3D" id="Mat_visor"]
albedo_color = Color(0.1, 0.12, 0.15, 1)
metallic = 0.8
roughness = 0.1

[sub_resource type="BoxMesh" id="Mesh_visor"]
material = SubResource("Mat_visor")
size = Vector3(0.5, 0.18, 0.14)

[sub_resource type="BoxMesh" id="Mesh_tool"]

[sub_resource type="SceneReplicationConfig" id="Repl_player"]
properties/0/path = NodePath(".:position")
properties/0/spawn = true
properties/0/replication_mode = 1
properties/1/path = NodePath(".:rotation")
properties/1/spawn = true
properties/1/replication_mode = 1
properties/2/path = NodePath("Head:rotation")
properties/2/spawn = true
properties/2/replication_mode = 1
properties/3/path = NodePath(".:tool")
properties/3/spawn = true
properties/3/replication_mode = 2
properties/4/path = NodePath("Vitals:knocked")
properties/4/spawn = true
properties/4/replication_mode = 2

[node name="Player" type="CharacterBody3D"]
editor_description = "ONE CREW MEMBER (CrewMember). Movement, mouse look, aiming and input routing.
The owning player moves it; every effect on the facility is sent to the host via Mission.send()."
collision_layer = 2
collision_mask = 5
script = ExtResource("1_cm")

[node name="Shape" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("Shape_body")

[node name="Body" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
layers = 2
mesh = SubResource("Mesh_body")

[node name="Visor" type="MeshInstance3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.55, -0.3)
layers = 2
mesh = SubResource("Mesh_visor")

[node name="Head" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 0)

[node name="Camera3D" type="Camera3D" parent="Head"]
cull_mask = 1048573
fov = 80.0
near = 0.08

[node name="InteractRay" type="RayCast3D" parent="Head/Camera3D"]
editor_description = "Finds InteractPoints (hooks, anchors, braces, valves, lever) up to 6 m. Only collides with the interact layer."
target_position = Vector3(0, 0, -6)
collision_mask = 8
collide_with_areas = true
collide_with_bodies = false

[node name="GrabRay" type="RayCast3D" parent="Head/Camera3D"]
editor_description = "Finds props to grab (4 m) and walls that block interaction."
target_position = Vector3(0, 0, -4)
collision_mask = 5

[node name="ToolModel" type="MeshInstance3D" parent="Head"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.34, -0.32, -0.75)
mesh = SubResource("Mesh_tool")

[node name="NameLabel" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.15, 0)
billboard = 1
font_size = 40
outline_size = 10
text = "Crew"

[node name="Tools" type="Node" parent="."]
editor_description = "The three hand tools. Child order = hotkeys 1-3. Each extends CrewTool."

[node name="Winch" type="Node" parent="Tools"]
editor_description = "WinchTool: LMB hook then LMB anchor rigs a cable; hold LMB/RMB on either end to reel."
script = ExtResource("2_wt")
display_name = "WINCH"
color = Color(1, 0.78, 0.1, 1)
model_size = Vector3(0.1, 0.1, 0.3)
handles = PackedStringArray("hook", "anchor")

[node name="Brace" type="Node" parent="Tools"]
editor_description = "BraceTool: LMB places a team brace on a BraceSocket; RMB recovers it."
script = ExtResource("3_bt")
display_name = "BRACE"
color = Color(1, 0.45, 0.1, 1)
model_size = Vector3(0.05, 0.05, 0.5)
handles = PackedStringArray("brace")

[node name="Pressure" type="Node" parent="Tools"]
editor_description = "PressureTool: LMB/RMB turns valves; elsewhere, hold to blast/pull loose props."
script = ExtResource("4_pt")
display_name = "PRESSURE"
color = Color(0.2, 0.85, 1, 1)
model_size = Vector3(0.08, 0.08, 0.4)
handles = PackedStringArray("valve")

[node name="Hands" type="Node" parent="."]
editor_description = "Grabbing with E. grab_force caps what one person can move: the 300 kg core needs two people (or the winch)."
script = ExtResource("5_ha")

[node name="Vitals" type="Node" parent="."]
editor_description = "Breath and knockouts. Signals: knocked_out / recovered -> Player."
script = ExtResource("6_vi")

[node name="Sync" type="MultiplayerSynchronizer" parent="."]
editor_description = "Replicates this player's position, rotation, aim, selected tool and knocked state from its owner to everyone."
replication_config = SubResource("Repl_player")

[connection signal="knocked_out" from="Vitals" to="." method="_on_knocked_out"]
[connection signal="recovered" from="Vitals" to="." method="_on_recovered"]
